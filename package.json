{
  "name": "knowitall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "parse:ikf": "node scripts/ikf_parser.js --no-warnings",
    "parse:ikf:warn": "node scripts/ikf_parser.js",
    "fetch:av": "node scripts/av_fetcher.js",
    "fetch:yahoo": "node scripts/yahoo_fetcher.js",
    "aggregate": "node scripts/aggregator.js",
